/span> pada <span>hari</span>\nyang <span>telah</span> <span>ditentukan</span>, <span>Rasulullah</span> SAW <span>keluar</span> pada <span>waktu</span> <span>matahari</span> <span>terbit</span>; <span>kemudian</span> <span>beliau</span> <span>berdiri</span> di <span>mimbar</span>, <span>lalu</span> <span>bertakbir</span>\ndan <span>memuji</span> Allah '<span>Azza</span> <span>wa</span> <span>Jalla</span>. Setelah <span>itu</span> <span>beliau</span> <span>bersabda</span>,\n\"<span>Sesungguhnya</span> kalian <span>mengadu</span>\n<span>kekeringan</span> dan <span>keterlambatan</span>\n<span>hujan</span> <span>daripada</span> <span>waktu</span> yang <span>biasa</span>, <span>sedang</span> Allah '<span>Azza</span> <span>wa</span> <span>Jalla</span> <span>telah</span>\n<span>memerintahkan</span> agar kalian <span>memohon</span>\n<span>kepada</span>-Nya dan <span>Dia</span> <span>menjanjikan</span> <span>akan</span> <span>memperkenankan</span> <span>permohonan</span>\nkalian\". <span>Kemudian</span> <span>beliau</span>\n<span>berdoa</span>, \"Al-<span>hamdu</span> <span>lillaahi</span> <span>Robbil</span> '<span>aalamiin</span> .... <span>dst</span>\". (<span>Segala</span> <span>puji</span> <span>bagi</span>\nAllah <span>Tuhan</span> <span>semesta</span> <span>alam</span>. <span>Maha</span> <span>Pemurah</span>\n<span>lagi</span> <span>Maha</span> <span>Penyayang</span>. Raja di <span>hari</span> <span>pembalasan</span>. <span>Tidak</span> <span>ada</span> <span>Tuhan</span> yang <span>layak</span> <span>disembah</span> <span>melainkan</span> Allah. <span>Dia</span> <span>berbuat</span> <span>apa</span> yang <span>dikehendaki</span>-Nya. <span>Ya</span> Allah, <span>Engkaulah</span> Allah yang <span>tidak</span> <span>ada</span> <span>Tuhan</span> <span>melainkan</span>\n<span>Engkau</span>, Yang <span>Maha</span> Kaya dan <span>kamilah</span> yang <span>sangat</span> <span><span>membutuhkan</span></span><span>(</span>Mu),\n<span>turunkanlah</span> <span>atas</span> kami